{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--prefix", "dev/frontend", "--", "--port", "5174"],
      "port": 5174
    },
    {
      "name": "backend",
      "runtimeExecutable": "uv",
      "runtimeArgs": [
        "run",
        "--project",
        "dev/backend",
        "uvicorn",
        "app.main:app",
        "--reload",
        "--app-dir",
        "dev/backend",
        "--port",
        "8000"
      ],
      "env": {
        "CORS_ORIGINS": "[\"http://localhost:5173\",\"http://localhost:5174\",\"http://localhost:5175\",\"http://localhost:53326\"]"
      },
      "port": 8000
    }
  ]
}
