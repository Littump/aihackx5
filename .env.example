TEST_DATABASE_URL=postgresql://domovoy:domovoy@localhost:5433/domovoy_test
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5
APP_ENV=dev
DEMO_NOW=
VITE_API_URL=http://localhost:8000

# --- ML-планировщик челленджей (E14 AI-008): remote vLLM (OpenAI API) на HGX H100 root@inference-node.local ---
# Два сервера подняты бок о бок на GPU 3-6 (TP4, FP8, offline batch, max ctx 32k). Docker-контейнеры
# `qwen38-27b-cap` (порт 8016) и `deepseek-v4-flash` (порт 8017). Локально — через SSH-туннель
# (см. AGENTS.md): `-L 18016:localhost:8016` и `-L 18017:localhost:8017`.
#   Cheap/fast (по умолчанию): Qwen3-VL 27B FP8   -> модель `qwen38-27b-fp8`  (для structured JSON слать enable_thinking=false)
#   Larger/near-frontier    : DeepSeek-V4-Flash    -> модель `deepseek-v4-flash` (160B MoE, MLA, kv fp8)
# Planner (награды) и actor (симуляция покупателя) — строго разные модели.
# Planner — дешёвый Qwen; actor — сильный DeepSeek (моделируем: человек умнее эконом-политики).
ML_PLANNER_BASE_URL=http://localhost:18016/v1
ML_PLANNER_MODEL=qwen38-27b-fp8
ML_ACTOR_BASE_URL=http://localhost:18017/v1
ML_ACTOR_MODEL=deepseek-v4-flash
