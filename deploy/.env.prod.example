# Скопировать в .env рядом с docker-compose.prod.yml (на VM — /opt/domovoy/.env) и заполнить.
TAG=latest

POSTGRES_USER=domovoy
POSTGRES_PASSWORD=
POSTGRES_DB=domovoy

# Docker compose .env не подставляет переменные друг в друга — держать в синхроне с POSTGRES_* выше.
DATABASE_URL=postgresql://domovoy:CHANGE_ME@postgres:5432/domovoy

ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5
APP_ENV=prod
DEMO_NOW=
CORS_ORIGINS=[]

# --- ML-планировщик челленджей (E14 AI-008): удалённые OpenAI-совместимые эндпоинты (vLLM/SGLang) ---
# Planner (награды): Qwen3 27B FP8, TP4 на GPU 3-6 (:8016, модель qwen38-27b-fp8).
# Actor (действия покупателя): MiniMax-M3 на SGLang-узле (:8080, модель MiniMaxAI/MiniMax-M3-MXFP8).
# Заполнять, только если планировщик ходит в vLLM/SGLang, а не в Anthropic.
# Адрес узлов и доступ — в gitignored-скилле .codex/skills/inference-node/SKILL.md.
# Actor троттлится по /metrics узла actor (<30% занятости; до eval ждём <50%).
# ML_PLANNER_BASE_URL=http://localhost:18016/v1
# ML_PLANNER_MODEL=qwen38-27b-fp8
# ML_ACTOR_BASE_URL=http://localhost:8080/v1
# ML_ACTOR_MODEL=MiniMaxAI/MiniMax-M3-MXFP8
