# Скопировать в .env рядом с docker-compose.prod.yml (на VM — /opt/domovoy/.env) и заполнить.
TAG=latest

POSTGRES_USER=domovoy
POSTGRES_PASSWORD=
POSTGRES_DB=domovoy

# Docker compose .env не подставляет переменные друг в друга — держать в синхроне с POSTGRES_* выше.
DATABASE_URL=postgresql://domovoy:CHANGE_ME@postgres:5432/domovoy

ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5
APP_ENV=prod
DEMO_NOW=
CORS_ORIGINS=[]

# --- ML-планировщик челленджей (E14 AI-008): remote vLLM (OpenAI API) на HGX H100 inference-node.local ---
# Два сервера бок о бок на GPU 3-6 (TP4, FP8, offline): Qwen3-VL 27B FP8 (:8016, модель qwen38-27b-fp8)
# и DeepSeek-V4-Flash (:8017, модель deepseek-v4-flash). Заполнять только если планировщик ходит в vLLM,
# а не в Anthropic. Прод достаёт кластер напрямую по IP или через SSH-туннель (18016->8016, 18017->8017).
# Planner (награды) и actor (симуляция покупателя) — строго разные модели:
# ML_PLANNER_BASE_URL=http://inference-node.local:8016/v1
# ML_PLANNER_MODEL=qwen38-27b-fp8
# ML_ACTOR_BASE_URL=http://inference-node.local:8017/v1
# ML_ACTOR_MODEL=deepseek-v4-flash
