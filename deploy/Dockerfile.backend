# Build context: repo root — так же, как у Dockerfile.frontend, для единообразия в CI.
FROM python:3.12-slim AS builder

RUN pip install --no-cache-dir uv

# Путь повторяет dev/backend из репозитория: app/core/config.py ищет .env через parents[4].
WORKDIR /app/dev/backend
COPY dev/backend/pyproject.toml dev/backend/uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project

COPY dev/backend/app ./app
COPY dev/backend/scripts ./scripts
COPY dev/backend/migrations ./migrations
RUN uv sync --frozen --no-dev

FROM python:3.12-slim

RUN groupadd --system app && useradd --system --gid app --home-dir /app --create-home app

WORKDIR /app/dev/backend
COPY --from=builder --chown=app:app /app /app
ENV PATH="/app/dev/backend/.venv/bin:$PATH" PYTHONUNBUFFERED=1

USER app
EXPOSE 8000

# curl отсутствует в slim-образе, поэтому healthcheck ходит через python.
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/api/v1/health', timeout=2)" || exit 1

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
