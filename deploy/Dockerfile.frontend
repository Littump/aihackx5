# Build context: repo root, чтобы этот же stage мог забрать deploy/nginx.conf.
FROM node:22-alpine AS build

WORKDIR /app
COPY dev/frontend/package.json dev/frontend/package-lock.json ./
RUN npm ci

COPY dev/frontend/ ./
# Пустой VITE_API_URL — фронт ходит на относительный /api, проксируемый nginx'ом.
ARG VITE_API_URL=
ENV VITE_API_URL=$VITE_API_URL
RUN npm run build

FROM nginx:alpine

COPY --from=build /app/dist /usr/share/nginx/html
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

# 127.0.0.1, не localhost — nginx.conf слушает только IPv4, а wget резолвит localhost в ::1 первым
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
  CMD wget -q -O- http://127.0.0.1/ >/dev/null || exit 1
